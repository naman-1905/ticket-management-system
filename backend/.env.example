DATABASE_URL=postgresql+asyncpg://user:pass@host.docker.internal:5432/ticketing_db
JWT_SECRET_KEY=change-me-in-production-use-secrets-token-urlsafe-64
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
APP_VERSION=2.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ticket.namanchaturvedi.com,http://192.168.1.38
DOCS_ENABLED=true
STORAGE_DIR=./storage
WORKER_POLL_SECONDS=30

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# LLM for email-to-ticket extraction (OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:8888/api/v1
LLM_MODEL=default
LLM_API_KEY=

# Email sync interval in seconds
EMAIL_SYNC_INTERVAL_SECONDS=300
